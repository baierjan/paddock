FROM registry.opensuse.org/opensuse/tumbleweed:latest
MAINTAINER Jan Baier <jbaier@suse.cz>

# Basic metadata
LABEL maintainer="Jan Baier <jbaier@suse.cz>" \
      description="Paddock - Ultra-Minimal Base AI sandbox container"

# 1. Install core system packages
RUN zypper --non-interactive refresh && \
    zypper --non-interactive install --no-recommends \
        bash \
        ca-certificates \
        curl \
        diffutils \
        file \
        findutils \
        gawk \
        git \
        gzip \
        jq \
        less \
        nodejs \
        npm \
        openssh-clients \
        python3 \
        starship \
        tar \
        unzip \
        util-linux \
        wget \
        which \
        zip \
    && zypper clean --all \
    && rm -rf /var/cache/zypp/* /tmp/* /var/tmp/*

# 2. Install AI CLI assistants and the Google Cloud CLI globally.
# NOTE: the cloud-sdk repo is x86_64-only, so this image is x86_64-only.
ARG GEMINI_CLI_VER=0.54.0
ARG GEMINI_CLI_HASH=3a56deaf930ad75e98858cdd4a7d3f50f368deb6f18f80891204810112042f02859b5347189e0573b90c8ef10f3cbb718a9d00922f3150cdbc1c6e2c436184d2
ARG OPENCODE_AI_VER=1.18.14
ARG OPENCODE_AI_HASH=139b289fc110921f9c4376d891e182392353731f309a0b07059ddb263634ace03ce096916f756faa47d3e3503c0a1804cf06d235eeeecc41c32aa24e90d3329d

RUN curl -fsSL -o /tmp/gemini-cli.tgz https://registry.npmjs.org/@google/gemini-cli/-/gemini-cli-${GEMINI_CLI_VER}.tgz && \
    echo "${GEMINI_CLI_HASH}  /tmp/gemini-cli.tgz" | sha512sum -c - && \
    curl -fsSL -o /tmp/opencode-ai.tgz https://registry.npmjs.org/opencode-ai/-/opencode-ai-${OPENCODE_AI_VER}.tgz && \
    echo "${OPENCODE_AI_HASH}  /tmp/opencode-ai.tgz" | sha512sum -c - && \
    npm install -g /tmp/gemini-cli.tgz /tmp/opencode-ai.tgz && \
    rm -f /tmp/gemini-cli.tgz /tmp/opencode-ai.tgz && \
    npm cache clean --force && \
    rpm --import https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg && \
    zypper --non-interactive addrepo --gpgcheck --refresh --name "Google Cloud CLI" https://packages.cloud.google.com/yum/repos/cloud-sdk-el10-x86_64 google-cloud-cli && \
    zypper --gpg-auto-import-keys refresh && \
    zypper --non-interactive install --no-recommends google-cloud-cli && \
    zypper clean --all && \
    rm -rf /var/cache/zypp/* /tmp/* /var/tmp/*

# 3. Create non-root user `ai` with a pristine home directory
RUN groupadd --gid 1000 ai && \
    useradd --uid 1000 --gid 1000 --home-dir /home/ai --shell /bin/bash --no-create-home ai && \
    mkdir -p /home/ai && \
    chown ai:ai /home/ai

# 4. Global configurations
RUN echo 'eval "$(starship init bash)"' >> /etc/bash.bashrc

# 5. Copy and setup entrypoint script for secure guest VM privilege dropping
COPY --chmod=755 profiles/base/entrypoint.sh /usr/local/bin/entrypoint.sh

USER ai
ENV HOME=/home/ai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/local/bin:/usr/bin:/bin \
    TERM=xterm-256color

WORKDIR /home/ai

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash", "--login"]
