FROM paddock-base:latest
MAINTAINER Jan Baier <jbaier@suse.cz>
USER root

# Install developer tools system-wide
RUN zypper --non-interactive refresh && \
    zypper --non-interactive install --no-recommends \
        ShellCheck \
        bash-completion \
        bat \
        glibc-locale \
        kitty-terminfo \
        make \
        openssl \
        osc \
        perl \
        python3-yamllint \
        rpm-build \
        rpmlint \
        spec-cleaner \
        vim \
    && zypper clean --all \
    && rm -rf /var/cache/zypp/* /tmp/* /var/tmp/*

# Override the base's C.UTF-8 default with a fully localized en_US locale,
# now that glibc-locale is installed to provide it.
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Personal preference, not shared by every profile: override the base's
# TERM default now that kitty's terminfo entry is actually installed here.
ENV TERM=xterm-kitty

# `LABEL run` is intentionally not defined here: paddock.sh's run_label_for()
# bakes it in at build time via `podman build --label`, so it can read
# env-var-driven resource limits and an XDG-aware home path that a static
# LABEL instruction cannot. See AGENTS.md, "The run label has exactly one
# home per profile".

USER ai
